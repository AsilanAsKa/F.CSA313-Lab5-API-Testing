{
  "info": {
    "name": "Lab05 - Registration API Tests",
    "description": "Course registration API exercised with Postman/Newman",
    "schema": "https://schema.getpostman.com/json/collection/v1.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Test 1 - Happy path",
      "item": [
        {
          "name": "Setup - Active student B231234567",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"status\":\"active\",\"coursesTaken\":[\"CS201\"]}"
            },
            "url": "{{baseUrl}}/students/B231234567"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Response result is OK\", function () { var json = pm.response.json(); pm.expect(json.result).to.eql(\"OK\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Setup - Course CS313 requires CS201",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"prerequisites\":[\"CS201\"]}"
            },
            "url": "{{baseUrl}}/courses/CS313"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Response result is OK\", function () { var json = pm.response.json(); pm.expect(json.result).to.eql(\"OK\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Happy path - valid registration",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"studentID\":\"B231234567\",\"courseID\":\"CS313\"}"
            },
            "url": "{{baseUrl}}/registrations"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"Response result is OK\", function () { var json = pm.response.json(); pm.expect(json.result).to.eql(\"OK\"); });",
                  "pm.test(\"registrationID exists and is numeric\", function () { var json = pm.response.json(); pm.expect(json.registrationID).to.be.a(\"number\"); });"
                ]
              }
            }
          ]
        }
      ]
    },
